# --- Required (dev and prod) ---
OPENROUTER_API_KEY=

# --- Required (production only) ---
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Postgres (production only) ---
# SQL_PASSWORD must match POSTGRES_PASSWORD
POSTGRES_DB=tokenbury
POSTGRES_USER=tokenbury
POSTGRES_PASSWORD=
DATABASE=postgres
SQL_HOST=db
SQL_PORT=5432
SQL_DATABASE=tokenbury
SQL_USER=tokenbury
SQL_PASSWORD=

# --- Optional ---
# LLM_MODEL=anthropic/claude-haiku-4-5
# TICK_INTERVAL_MINUTES=15
# PLAN_HOUR=6
# LOG_LEVEL=INFO
# API_HIDE_FUTURE_TICKS=false
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# SITE_URL=https://yourdomain.com

# --- Auto-ticker ---
# Uncomment to enable the automatic ticker service in Docker Compose.
# It runs `run_ticker --catchup` every TICK_INTERVAL_MINUTES minutes.
# COMPOSE_PROFILES=ticker
# TICKER_POLL_INTERVAL_MINUTES=5

# --- Werewolf ---
# Add `werewolf` to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=ticker,werewolf) to run
# one night and day of the latest published game each day after WEREWOLF_RUN_HOUR (UTC).
# WEREWOLF_LLM_MODEL=anthropic/claude-haiku-5.5
# WEREWOLF_RUN_HOUR=0
# WEREWOLF_POLL_INTERVAL_MINUTES=15
